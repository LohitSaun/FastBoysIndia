# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#
# Anything starting with EXPO_PUBLIC_ is bundled INTO the app, and anyone who
# downloads the app can read it. Only public ("publishable") values go here.
# Never put the Supabase secret key, database password or Sentry auth token here.

# Supabase dashboard → your project → Connect (or Project Settings → API Keys)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Sentry → Project Settings → Client Keys (DSN). Leave empty to keep Sentry off.
EXPO_PUBLIC_SENTRY_DSN=

# PostHog → Project Settings → Project API key. Leave empty to keep analytics off.
EXPO_PUBLIC_POSTHOG_API_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com (match the region you signed up in)
EXPO_PUBLIC_POSTHOG_HOST=

# ---- Build-time only: read by app.config.ts, NOT bundled into the app ----
# Sentry org/project slugs, used to upload source maps during EAS builds.
# The matching SENTRY_AUTH_TOKEN is a secret: store it with `eas env:create`, not here.
SENTRY_ORG=
SENTRY_PROJECT=
